@Tutorial(time: 9) {
    @Intro(title: "모든 기존 점에 다시 연결하기") {
        **이번 단계에서 만들 것**: 현재 별자리의 어느 기존 점에든 새 점 없이 선을 연결하는 `ExistingPointConnectionDetector`입니다.

        첫 점만 특별 취급하지 않습니다. 감지기는 여러 목표 중 가장 가까운 하나를 고정하고, 모델은 그 목표의 저장 좌표를 재사용합니다.

        @Image(source: closure-snap-feedback.png, alt: "여러 기존 점 중 하나를 선택해 미리보기 선과 연결 완료를 보여 주는 세 단계")
    }

    @Section(title: "연결 목표를 안정적으로 고르기") {
        @Steps {
            @Step {
                현재 출발점은 자기 연결을 막기 위해 후보에서 제외합니다. 다른 별자리의 점도 후보로 전달하지 않습니다.
            }

            @Step {
                출발점에서 3cm 이상 떠난 뒤 손가락에서 3cm 이내인 기존 점 중 가장 가까운 점을 고릅니다.
            }

            @Step {
                체류가 시작되면 목표 ID를 고정합니다. 다른 점이 더 가까워져도 4cm 해제 반경을 벗어나기 전에는 바꾸지 않습니다.
            }

            @Step {
                0.8초를 채우면 `didCommit`을 한 번만 내보냅니다. 결과에는 목표 ID, 정확한 저장 위치와 중복 연결 여부가 포함됩니다.
            }
        }
    }

    @Section(title: "연결 감지기 완성하기") {
        @Steps {
            @Step {
                최근접 선택, 목표 잠금, 진입·해제 히스테리시스와 추적 손실 처리를 한 타입에 모읍니다.

                @Code(name: "ExistingPointConnectionDetector.swift", file: C04-T06-ExistingPointConnectionDetector-01.swift, previousFile: C04-T01-ExistingPointConnectionDetector-00.swift)
            }

            @Step {
                **결과 확인**: `swift test`에서 출발점 이탈, 최근접 선택, 목표 잠금, 0.8초 완료, 경계 흔들림과 해제 시나리오가 통과하면 성공입니다.
            }

            @Step {
                **문제가 생겼다면**: 목표가 점 사이에서 바뀌면 선택 후 `nodeID`를 저장했는지 확인하세요. 매 프레임 최근접 점을 다시 선택하면 안 됩니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            기존 점 연결에서 손가락의 현재 좌표로 새 점을 만들지 않는 이유는 무엇인가요?

            @Choice(isCorrect: true) {
                저장된 점을 정확히 재사용하고 점 개수가 늘어나는 것을 막기 위해서입니다.

                @Justification(reaction: "맞습니다!") {
                    감지기는 목표 ID를 확정하고 모델은 해당 노드의 좌표를 사용합니다.
                }
            }

            @Choice(isCorrect: false) {
                RealityKit은 같은 위치에 구를 두 개 만들 수 없기 때문입니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    겹친 엔티티는 만들 수 있지만 데이터와 화면에 중복 점이 남습니다.
                }
            }
        }
    }
}
