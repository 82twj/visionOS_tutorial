@Tutorial(time: 9) {
    @Intro(title: "처음 점으로 돌아가 도형 닫기") {
        **이번 단계에서 만들 것**: 일반 점 생성과 별개로, 시작점 근처의 의도적인 체류를 한 번의 도형 닫기 입력으로 바꾸는 `ClosureDetector`입니다.

        시작점 근처에 새 점을 허용하는 것만으로는 손 추적 오차 때문에 네 번째 점이 옆에 생깁니다. 닫기는 **새 점 생성**이 아니라 **기존 시작점 선택**이어야 합니다.

        @Image(source: closure-snap-feedback.png, alt: "세 점으로 만든 삼각형에서 첫 점이 강조되고 마지막 점부터 첫 점까지 미리보기 선이 나타나는 세 단계")
    }

    @Section(title: "닫기 입력의 네 가지 조건") {
        @ContentAndMedia {
            닫기 대상은 점이 세 개 이상일 때만 나타납니다. 세 번째 점을 찍은 자리에 계속 머무르는 것만으로 닫히지 않도록, 손가락이 직전 점의 안정 반경을 먼저 벗어나야 합니다.

            @Image(source: closure-snap-feedback.png, alt: "닫기 가능, 시작점 스냅, 닫기 완료 상태를 보여 주는 그림")
        }

        @Steps {
            @Step {
                점이 세 개 미만이면 닫기 대상을 공개하지 않습니다. A와 B만 만든 뒤 A로 돌아가는 입력은 삼각형이 아니므로 중복 점으로 거부합니다.
            }

            @Step {
                세 번째 점을 만든 뒤에는 직전 점에서 1.5cm 이상 떠나야 닫기 입력이 재활성화됩니다. 같은 체류를 두 번 해석하지 않기 위한 조건입니다.
            }

            @Step {
                첫 점에서 3cm 안으로 들어오면 닫기 dwell을 시작합니다. 시작한 뒤에는 4cm까지 허용해 경계의 작은 손 떨림으로 진행률이 리셋되지 않게 합니다.
            }

            @Step {
                0.8초를 채우면 `didCommit`을 한 번만 내보냅니다. 추적이 끊기거나 4cm 밖으로 나가면 진행 중인 체류를 취소합니다.
            }
        }
    }

    @Section(title: "ClosureDetector 완성하기") {
        @ContentAndMedia {
            `Snapshot`은 화면에 필요한 대상 위치와 진행률, 완료 신호만 공개합니다. 내부에서는 직전 점을 벗어났는지와 스냅 영역 안에 있는지를 따로 기억합니다.
        }

        @Steps {
            @Step {
                `ClosureDetector.swift`를 완성하세요. 진입·해제 반경이 다른 히스테리시스, 직전 점 이탈 조건, 단조 증가 시간 계산과 추적 손실 취소가 한 타입에 모입니다.

                @Code(name: "ClosureDetector.swift", file: C04-T06-ClosureDetector-01.swift, previousFile: C04-T01-ClosureDetector-00.swift)
            }

            @Step {
                **결과 확인**: `swift test`에서 세 점 미만 비활성화, 직전 점 이탈, 0.8초 완료, 경계 흔들림, 영역 이탈, 추적 손실 시나리오가 모두 통과하면 성공입니다.
            }

            @Step {
                **문제가 생겼다면**: 시작점 근처에서 표시가 깜빡이면 진입 거리보다 해제 거리가 크거나 같은지 확인하세요. `releaseDistance >= snapDistance`여야 합니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            닫을 때 손가락의 현재 좌표에 새 점을 추가하지 않는 이유는 무엇인가요?

            @Choice(isCorrect: true) {
                손 추적 오차가 있어도 선의 끝이 기존 첫 점과 정확히 일치하도록 하기 위해서입니다.

                @Justification(reaction: "맞습니다!") {
                    감지기는 사용자의 의도만 확정하고, 모델은 저장된 첫 점 좌표를 재사용합니다.
                }
            }

            @Choice(isCorrect: false) {
                RealityKit은 같은 위치에 구를 두 개 만들 수 없기 때문입니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    구를 겹쳐 만들 수는 있지만, 데이터와 화면에 중복 점이 남아 닫힌 도형이 정확하지 않게 됩니다.
                }
            }
        }
    }
}
