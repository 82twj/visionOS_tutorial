@Tutorial(time: 10) {
    @Intro(title: "여러 별자리를 나누어 저장하기") {
        **시작 상태**: Chapter 4의 설정과 두 감지기가 빌드됩니다.

        **이번 단계에서 만들 것**: 새 `ConstellationModel.swift` 파일과, 확정된 점과 연결을 별자리 단위로 저장하는 그래프 모델입니다.

        단순한 점 배열만으로는 임의의 기존 점을 다시 연결하거나 같은 선의 중복을 판별하기 어렵습니다. 그래서 각 별자리가 안정적인 ID를 가진 노드와 중복 없는 간선 집합을 갖게 합니다.

        @Image(source: constellation-storage.png, alt: "각 별자리가 노드와 간선 집합을 가지며 별자리 사이에는 선이 없음을 보여 주는 그림")
    }

    @Section(title: "저장 구조 이해하기") {
        @ContentAndMedia {
            `[Constellation]`에서 원소 하나가 별자리 하나입니다. 각 원소는 ID가 있는 노드 배열, 중복 없는 간선 집합, 현재 활성 노드 ID를 가집니다.

            @Image(source: constellation-storage.png, alt: "노드와 간선으로 두 별자리를 저장한 구조 그림")
        }

        @Steps {
            @Step {
                앱 그룹에서 **New File from Template > Swift File**을 골라 `ConstellationModel.swift`를 만드세요. 앱 target membership을 확인합니다.

                @Code(name: "ConstellationModel.swift", file: C05-T01-ConstellationModel-00.swift, reset: true)
            }

            @Step {
                오른쪽 그림의 첫 번째 줄이 `constellations[0]`입니다. 노드는 좌표와 ID를 보관하고, 간선은 두 노드 ID의 정규화된 쌍을 보관합니다.
            }

            @Step {
                두 번째 줄이 `constellations[1]`입니다. 같은 규칙으로 자기 안에서만 이어집니다.
            }

            @Step {
                아래 오른쪽 카드를 보세요. `[0]`과 `[1]` 사이에는 간선이 생기지 않습니다. 다시 연결할 수 있는 후보도 **현재 별자리의 노드**로 제한합니다.
            }
        }
    }

    @Section(title: "타입 정의하기") {
        @ContentAndMedia {
            이 타입은 화면을 모릅니다. 점을 받아 받아들일지 결정하고, 받아들였다면 어떤 선분이 새로 생겼는지 알려 줄 뿐입니다.
        }

        @Steps {
            @Step {
                `import Foundation`을 `import simd`로 바꾸고 `Sendable`을 따르는 빈 struct를 선언하세요. 이 파일에는 위치 계산만 있으므로 `Foundation`이 필요하지 않습니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-01.swift, previousFile: C05-T01-ConstellationModel-00.swift)
            }

            @Step {
                두 점을 잇는 `Segment`를 추가하세요. 렌더러는 이 값만 있으면 선 하나를 그릴 수 있습니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-02.swift, previousFile: C05-T02-ConstellationModel-01.swift)
            }

            @Step {
                점 추가 결과를 나타내는 enum을 추가하세요. 성공과 실패를 하나의 값으로 돌려주고, 실패 이유를 셋으로 나눕니다. 이유를 구분해 두면 화면에서 알맞은 안내를 할 수 있습니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-03.swift, previousFile: C05-T02-ConstellationModel-02.swift)
            }

            @Step {
                기준값 두 개와 저장 속성 두 개를 추가하세요. `isStartingNewConstellation`이 참이면 다음 점이 새 배열을 시작합니다. 이 한 개의 Boolean이 별자리 분리의 전부입니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-04.swift, previousFile: C05-T02-ConstellationModel-03.swift)
            }

            @Step {
                모든 점을 한 줄로 펼치는 속성과, 점 개수·별자리 개수를 세는 속성을 추가하세요. 창의 표시에 사용합니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-05.swift, previousFile: C05-T02-ConstellationModel-04.swift)
            }

            @Step {
                initializer에서 기본값을 설정에서 받으세요. 최소 간격 3cm와 최대 100개가 기본값입니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-06.swift, previousFile: C05-T02-ConstellationModel-05.swift)
            }
        }
    }

    @Section(title: "점을 받아들이는 규칙 만들기") {
        @ContentAndMedia {
            세 개의 `guard`가 차례로 다른 실패를 막습니다. 값이 이상한 경우, 너무 많이 만든 경우, 직전 점과 너무 가까운 경우입니다.
        }

        @Steps {
            @Step {
                메서드를 선언하고 좌표가 유한한 수인지 확인하세요. 추적이 끊기는 순간의 값이 그대로 저장되는 것을 막습니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-07.swift, previousFile: C05-T02-ConstellationModel-06.swift)
            }

            @Step {
                점 개수가 최대치에 도달했는지 확인하세요. 장면에 엔티티가 무한히 쌓여 성능이 떨어지는 것을 막습니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-08.swift, previousFile: C05-T02-ConstellationModel-07.swift)
            }

            @Step {
                직전 점을 찾고 3cm보다 가까우면 거절하세요. 새 별자리를 시작하는 상황에서는 비교할 직전 점이 없으므로 `nil`이 됩니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-09.swift, previousFile: C05-T02-ConstellationModel-08.swift)
            }

            @Step {
                세 검사를 통과했다면 점을 저장하세요. 새 별자리면 배열을 하나 추가하고, 아니면 마지막 배열에 붙입니다. 선분은 직전 점이 있을 때만 만들어지므로, 새 별자리의 첫 점은 자동으로 선 없이 시작합니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-10.swift, previousFile: C05-T02-ConstellationModel-09.swift)
            }

            @Step {
                현재 별자리를 끝내는 메서드를 추가하세요. 점을 지우지 않고 다음 점을 새 별자리로 표시만 합니다. 그리기를 끌 때 이 메서드를 부릅니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-11.swift, previousFile: C05-T02-ConstellationModel-10.swift)
            }

            @Step {
                모든 점을 지우는 메서드를 추가하세요. 그리기를 끄는 것과 전체를 초기화하는 것은 서로 다른 동작이므로 메서드도 나눕니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-12.swift, previousFile: C05-T02-ConstellationModel-11.swift)
            }

            @Step {
                마지막으로 별자리를 노드와 간선의 그래프로 바꾸세요. 모든 기존 노드를 연결 후보로 제공하고, `connectCurrentNode(to:)`는 새 점 없이 저장된 목표 노드까지 간선을 추가합니다. 정규화된 간선 집합이 자기 연결과 같은 선의 중복을 거절합니다.

                @Code(name: "ConstellationModel.swift", file: C05-T02-ConstellationModel-14.swift, previousFile: C05-T02-ConstellationModel-13.swift)
            }

            @Step {
                **결과 확인**: 앱 target을 빌드하세요. 코드를 따라가며 기존 점 연결은 `pointCount`를 늘리지 않고, 정규화된 `Edge`가 같은 간선을 거절하며, `finishCurrentConstellation()` 뒤의 첫 점은 선분 없이 시작하는지 확인합니다. 다운로드한 저장소의 별도 테스트 구성을 사용하는 경우에만 해당 테스트도 실행할 수 있습니다.
            }

            @Step {
                **문제가 생겼다면**: `hasFiniteComponents`를 찾을 수 없다면 Chapter 4의 `DwellDetector.swift` 맨 아래에 있는 `extension SIMD3`가 들어갔는지 확인하세요. 중간 Step의 임시 반환 줄이 남아 있다면 지웁니다.
            }
        }
    }
}
