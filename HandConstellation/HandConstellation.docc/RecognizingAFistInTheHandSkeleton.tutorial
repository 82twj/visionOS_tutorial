@Tutorial(time: 7) {
    @Intro(title: "손 골격에서 주먹 판정 추가하기") {
        **이번 단계에서 만들 것**: 손 앵커 하나를 보고 오른손이 주먹인지 판단하는 메서드입니다. 기존 `HandTrackingService.swift`에 추가합니다.

        ARKit은 "주먹"이라는 손짓을 직접 알려 주지 않습니다. 관절 위치만 주므로, 손가락이 접혔는지를 직접 계산해야 합니다.

        @Image(source: hand-skeleton-joints.png, alt: "손목과 손가락 관절을 이은 오른손 골격 도해")
    }

    @Section(title: "비율로 접힘을 재는 이유") {
        @ContentAndMedia {
            손가락 끝과 손목의 **거리**만 보면 손이 큰 사람과 작은 사람에게 다른 기준이 됩니다.

            그래서 손가락 끝까지의 거리를 같은 손가락 마디까지의 거리로 나눕니다. 손을 폈을 때는 이 비율이 크고, 접었을 때는 작아집니다. 손 크기가 달라도 비율은 비슷하게 유지됩니다.

            @Image(source: hand-skeleton-joints.png, alt: "손목, 마디, 손가락 끝 관절이 표시된 골격 도해")
        }

        @Steps {
            @Step {
                메서드를 선언하고 오른손인지, 앵커가 추적 중인지, 손 골격이 있는지 확인하세요. 반환 타입이 `Bool?`인 점에 주목하세요. 참과 거짓 외에 "판단할 수 없음"을 따로 나타내야 하기 때문입니다.

                @Code(name: "HandTrackingService.swift", file: C04-T05-HandTrackingService-12.swift, previousFile: C03-T03-HandTrackingService-11.swift)
            }

            @Step {
                기준점이 될 손목 관절을 꺼내고 추적 상태를 확인하세요. 손목을 믿을 수 없으면 모든 거리 계산이 무의미해집니다.

                @Code(name: "HandTrackingService.swift", file: C04-T05-HandTrackingService-13.swift, previousFile: C04-T05-HandTrackingService-12.swift)
            }

            @Step {
                관절 하나의 위치를 꺼내는 private 도우미를 추가하세요. 손 앵커 기준 좌표이므로 월드 변환을 곱하지 않습니다. 서로 비교만 하면 되기 때문입니다.

                @Code(name: "HandTrackingService.swift", file: C04-T05-HandTrackingService-14.swift, previousFile: C04-T05-HandTrackingService-13.swift)
            }

            @Step {
                검사할 네 손가락의 끝 관절과 마디 관절을 짝지어 배열로 준비하세요. 엄지는 접어도 다른 손가락과 움직임이 달라 제외합니다.

                @Code(name: "HandTrackingService.swift", file: C04-T05-HandTrackingService-15.swift, previousFile: C04-T05-HandTrackingService-14.swift)
            }

            @Step {
                손목 위치를 한 번만 계산하고 유한한 값인지 확인하세요. 반복문 안에서 매번 계산하지 않습니다.

                @Code(name: "HandTrackingService.swift", file: C04-T05-HandTrackingService-16.swift, previousFile: C04-T05-HandTrackingService-15.swift)
            }

            @Step {
                네 손가락을 순회하며 두 관절을 꺼내고, 추적 상태와 값의 유한성을 확인하세요. 하나라도 믿을 수 없으면 `nil`을 돌려주어 "판단할 수 없음"을 알립니다.

                @Code(name: "HandTrackingService.swift", file: C04-T05-HandTrackingService-17.swift, previousFile: C04-T05-HandTrackingService-16.swift)
            }

            @Step {
                손목에서 마디까지의 거리로 손끝까지의 거리를 나누어 비율을 구하세요. 한 손가락이라도 기준보다 펴져 있으면 주먹이 아닙니다. 네 손가락이 모두 접혔을 때만 참을 돌려줍니다.

                @Code(name: "HandTrackingService.swift", file: C04-T05-HandTrackingService-18.swift, previousFile: C04-T05-HandTrackingService-17.swift)
            }

            @Step {
                **결과 확인**: 이 시점의 `HandTrackingService.swift`는 실제 앱의 완성본과 같습니다. 빌드가 성공하면 됩니다.
            }

            @Step {
                **문제가 생겼다면**: 나중에 실기기에서 주먹이 잘 인식되지 않거나 반대로 너무 쉽게 인식된다면, `ConstellationConfiguration`의 `fistFingerExtensionRatio` 값을 조금씩 조정하세요. 값을 낮추면 더 확실히 접어야 인식됩니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            같은 위치에서 점이 반복해서 생기는 것을 막는 상태는 무엇인가요?

            @Choice(isCorrect: false) {
                `idle`

                @Justification(reaction: "다시 생각해 보세요.") {
                    `idle`은 아직 체류 후보가 없는 초기 상태입니다.
                }
            }

            @Choice(isCorrect: true) {
                `coolingDown`

                @Justification(reaction: "맞습니다!") {
                    점을 만든 뒤 3cm 이상 멀어질 때까지 다음 입력을 막습니다.
                }
            }

            @Choice(isCorrect: false) {
                `dwelling`

                @Justification(reaction: "다시 생각해 보세요.") {
                    `dwelling`은 시간을 재는 중이며 점을 확정하기 직전 상태입니다.
                }
            }
        }

        @MultipleChoice {
            주먹을 계속 쥐고 있어도 그리기가 한 번만 전환되는 이유는 무엇인가요?

            @Choice(isCorrect: true) {
                전환 직후 `waitingForRelease`로 넘어가고, 손을 펴야 `ready`로 돌아오기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    한 번의 손짓이 정확히 한 번의 전환이 되도록 상태로 보장합니다.
                }
            }

            @Choice(isCorrect: false) {
                0.6초가 지나면 `HandTrackingProvider`가 손 앵커 전달을 멈추기 때문입니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    앵커는 계속 흘러오며, 판정만 상태로 제어됩니다.
                }
            }
        }

        @MultipleChoice {
            주먹 판정에서 거리 대신 비율을 쓰는 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                `simd_distance`가 미터 단위를 지원하지 않기 때문입니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    거리 계산 자체는 문제없이 동작합니다.
                }
            }

            @Choice(isCorrect: true) {
                손 크기가 달라도 같은 기준을 쓸 수 있기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    마디까지의 거리로 나누면 손 크기의 영향이 사라집니다.
                }
            }
        }
    }
}
