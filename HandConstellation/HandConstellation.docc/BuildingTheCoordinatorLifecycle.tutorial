@Tutorial(time: 7) {
    @Intro(title: "코디네이터의 생명주기 설계하기") {
        **이번 단계에서 만들 것**: 다음 페이지에서 완성할 `ImmersiveCoordinator`가 시작, 상태 변경, 초기화와 종료를 어떻게 책임지는지 설계합니다.

        @Image(source: scene-structure.png, alt: "SwiftUI 제어창과 혼합 몰입형 공간이 AppModel을 공유하는 구조")
    }

    @Section(title: "구성 요소와 수명 이해하기") {
        @Steps {
            @Step {
                코디네이터는 손 추적 서비스, 점 체류 감지기, 기존 점 연결 감지기, 그래프 모델과 렌더러를 소유합니다.
            }

            @Step {
                `run`은 권한을 확인하고 오른손 앵커 업데이트를 순회합니다. 화면 task가 취소되면 반복을 끝내고 세션과 커서를 정리합니다.
            }

            @Step {
                제어창 버튼으로 `drawingState`가 바뀌면 진행 중인 체류를 취소합니다. 꺼질 때는 현재 별자리를 마쳐 다음 시작을 분리합니다.
            }

            @Step {
                초기화는 감지기, 모델, 렌더러와 화면 개수를 모두 되돌립니다. 종료는 여기에 세션 중단과 그리기 꺼짐을 더합니다.
            }

            @Step {
                **결과 확인**: 손짓 감지기 없이 버튼 상태만으로 시작과 종료 경로를 설명할 수 있으면 다음 페이지로 이동하세요.
            }
        }
    }
}
