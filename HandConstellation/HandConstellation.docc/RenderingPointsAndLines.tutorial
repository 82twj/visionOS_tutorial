@Tutorial(time: 12) {
    @Intro(title: "RealityKit으로 점과 선 그리기") {
        **이번 단계에서 만들 것**: 확정된 점을 노란 구로, 두 점 사이를 파란 원기둥으로 그리는 `ConstellationRenderer`입니다.

        RealityKit은 3D 장면을 **엔티티 트리**로 다룹니다. 코드를 쓰기 전에 이 앱이 만들 트리 모양을 먼저 봅니다.

        @Image(source: entity-tree.png, alt: "rootEntity 아래에 선, 점, 닫기 안내 컨테이너와 커서가 자식으로 붙은 구조도")
    }

    @Section(title: "엔티티 트리 이해하기") {
        @ContentAndMedia {
            엔티티는 장면 안의 물체 하나입니다. 엔티티에 mesh와 material을 붙이면 눈에 보이고, 붙이지 않으면 자식들을 담는 빈 그룹이 됩니다.

            @Image(source: entity-tree.png, alt: "루트 엔티티와 선, 점, 닫기 안내 컨테이너 및 커서로 이루어진 트리 그림")
        }

        @Steps {
            @Step {
                맨 위 `rootEntity`는 장면에 딱 한 번 추가할 부모입니다. Chapter 6에서 `RealityView`에 이 하나만 넘깁니다.
            }

            @Step {
                아래의 세 자식을 보세요. 선, 점, 커서를 나누어 두면 초기화할 때 점과 선의 자식만 지우고 커서는 그대로 둘 수 있습니다.
            }

            @Step {
                커서는 체류 중일 때만 보여야 하므로 처음에는 꺼진 상태로 만듭니다. 엔티티는 `isEnabled`로 켜고 끕니다.
            }
        }
    }

    @Section(title: "엔티티와 재질 준비하기") {
        @ContentAndMedia {
            mesh는 모양, material은 표면 성질입니다. 점 mesh는 한 번만 만들어 모든 점이 함께 사용합니다. 같은 모양을 반복해 만들 필요가 없습니다.
        }

        @Steps {
            @Step {
                RealityKit과 UIKit을 import하고 클래스를 선언하세요. 색을 만들 때 `UIColor`를 쓰므로 UIKit이 필요합니다. `@MainActor`는 RealityKit 엔티티를 메인 스레드에서만 다루기 위한 것입니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-01.swift, previousFile: C05-T01-ConstellationRenderer-00.swift)
            }

            @Step {
                나머지 속성을 선언하세요. 지금은 초기값이 없어 오류가 보이지만, 다음 Step의 initializer에서 모두 채웁니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-02.swift, previousFile: C05-T03-ConstellationRenderer-01.swift)
            }

            @Step {
                initializer를 시작하고 세 엔티티에 이름을 붙이세요. 이름은 Xcode의 RealityKit 디버거에서 트리를 읽을 때 도움이 됩니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-03.swift, previousFile: C05-T03-ConstellationRenderer-02.swift)
            }

            @Step {
                점 mesh와 두 material을 만드세요. 점은 금속처럼 반사하게, 선은 덜 반사하게 설정해 두 요소를 눈으로 구분합니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-04.swift, previousFile: C05-T03-ConstellationRenderer-03.swift)
            }

            @Step {
                커서를 만드세요. `UnlitMaterial`은 조명을 받지 않아 어떤 환경에서도 같은 밝기로 보입니다. 커서는 항상 눈에 띄어야 하므로 알맞습니다. 마지막 줄에서 커서를 꺼 둡니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-05.swift, previousFile: C05-T03-ConstellationRenderer-04.swift)
            }

            @Step {
                세 자식을 루트에 붙여 트리를 완성하세요. 선을 먼저 붙이면 점이 선 위에 그려집니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-06.swift, previousFile: C05-T03-ConstellationRenderer-05.swift)
            }
        }
    }

    @Section(title: "점, 선, 커서 그리기") {
        @ContentAndMedia {
            두 점 사이에 선을 그리려면 원기둥을 만들고, 두 점의 중간에 놓은 뒤, 두 점을 잇는 방향으로 돌려야 합니다.

            RealityKit의 원기둥은 기본적으로 y축 방향으로 서 있습니다. 그래서 y축에서 목표 방향으로 가는 회전을 구하면 됩니다.
        }

        @Steps {
            @Step {
                커서를 옮기고 체류 진행률에 따라 크게 만드는 메서드를 추가하세요. 진행률이 0에서 1로 갈수록 커서가 커지므로, 사용자는 점이 언제 확정될지 눈으로 알 수 있습니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-07.swift, previousFile: C05-T03-ConstellationRenderer-06.swift)
            }

            @Step {
                커서를 숨기는 메서드를 추가하세요. 그리기가 꺼지거나 추적이 끊겼을 때 부릅니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-08.swift, previousFile: C05-T03-ConstellationRenderer-07.swift)
            }

            @Step {
                확정된 점을 추가하는 메서드를 만드세요. 선분이 함께 넘어오면 먼저 선을 그린 다음 점을 올립니다. 선분이 `nil`이면 새 별자리의 첫 점입니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-09.swift, previousFile: C05-T03-ConstellationRenderer-08.swift)
            }

            @Step {
                점과 선을 모두 지우는 메서드를 추가하세요. 두 컨테이너의 자식만 지우므로 커서 엔티티는 그대로 남습니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-10.swift, previousFile: C05-T03-ConstellationRenderer-09.swift)
            }

            @Step {
                마지막으로 선 하나를 그리는 private 메서드를 추가하세요. 두 점의 거리로 원기둥의 길이를 정하고, 중점에 놓은 다음, y축에서 두 점을 잇는 방향으로 회전합니다. 길이가 0에 가까우면 방향을 정할 수 없으므로 그리지 않습니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-11.swift, previousFile: C05-T03-ConstellationRenderer-10.swift)
            }

            @Step {
                닫기 안내 컨테이너를 추가하세요. 세 점 이상이면 첫 점보다 큰 반투명 구로 대상을 강조하고, 스냅 영역에서는 마지막 점부터 첫 점까지 가는 가는 미리보기 선을 표시합니다. 완료할 때는 새 점 없이 실제 선만 추가합니다.

                @Code(name: "ConstellationRenderer.swift", file: C05-T03-ConstellationRenderer-12.swift, previousFile: C05-T03-ConstellationRenderer-11.swift)
            }

            @Step {
                **결과 확인**: 이 시점의 `ConstellationRenderer.swift`는 실제 앱의 완성본과 같습니다. 빌드가 성공하면 됩니다. 입력 연결은 Chapter 6에서 완성합니다.
            }

            @Step {
                **문제가 생겼다면**: `UIColor`를 찾을 수 없다면 `import UIKit`이 들어갔는지 확인하세요. `simd_quatf`를 찾을 수 없다면 `import simd`가 필요합니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            두 번째 별자리의 첫 점이 첫 번째 별자리와 연결되지 않는 이유는 무엇인가요?

            @Choice(isCorrect: true) {
                `isStartingNewConstellation`이 참일 때는 직전 점을 찾지 않아 선분이 만들어지지 않기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    선분은 같은 배열 안의 직전 점이 있을 때만 만들어집니다.
                }
            }

            @Choice(isCorrect: false) {
                렌더러가 두 점의 거리가 멀면 선을 그리지 않기 때문입니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    렌더러에는 거리 상한이 없습니다. 판단은 모델이 합니다.
                }
            }
        }

        @MultipleChoice {
            `ConstellationModel`이 RealityKit을 import하지 않는 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                RealityKit을 import하면 빌드 시간이 너무 길어지기 때문입니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    이유는 빌드 시간이 아니라 책임 분리입니다.
                }
            }

            @Choice(isCorrect: true) {
                별자리 규칙을 화면과 분리해 macOS에서 그대로 테스트할 수 있게 하기 위해서입니다.

                @Justification(reaction: "맞습니다!") {
                    덕분에 visionOS 기기 없이도 `swift test`로 규칙을 검증할 수 있습니다.
                }
            }
        }
    }
}
