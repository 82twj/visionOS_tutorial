@Tutorial(time: 6) {
    @Intro(title: "버튼 전환과 두 번째 별자리 확인하기") {
        **이번 단계에서 만들 것**: 코드는 만들지 않습니다. 제어창 버튼으로 그리기를 끄고 다시 켰을 때 이전 결과와 분리된 새 별자리가 시작되는지 확인합니다.

        @Image(source: device-second-constellation.png, alt: "첫 번째 별자리와 두 번째 별자리 사이에 선이 없는 화면")
    }

    @Section(title: "버튼으로 그리기 끄기") {
        @ContentAndMedia {
            그리기 끄기는 기존 결과를 지우는 동작이 아닙니다. 새 입력을 멈추고 현재 별자리만 마칩니다.

            @Image(source: constellation-storage.png, alt: "각 별자리가 노드와 선 연결 정보를 따로 가지는 저장 구조")
        }

        @Steps {
            @Step {
                앞 페이지의 도형을 그대로 두고 제어창의 **그리기 끄기** 버튼을 누르세요. 상태가 **그리기 꺼짐**으로 바뀝니다.
            }

            @Step {
                오른손 검지를 공중에서 천천히 움직여 보세요. 커서가 사라지고 새 점이 생기지 않아야 합니다.
            }

            @Step {
                이미 만든 점과 선은 그대로 보여야 합니다. 사라진다면 그리기 끄기와 초기화 경로가 섞이지 않았는지 확인하세요.
            }
        }
    }

    @Section(title: "두 번째 별자리 만들기") {
        @ContentAndMedia {
            창의 버튼으로 다시 켜면 새 별자리의 첫 점에는 직전 점이 없으므로 이전 별자리와 연결선이 생기지 않습니다.

            @Image(source: device-second-constellation.png, alt: "두 별자리 사이에 선이 없는 것을 강조한 화면")
        }

        @Steps {
            @Step {
                첫 번째 별자리에서 멀리 떨어진 곳으로 손을 옮긴 뒤 제어창의 **그리기 켜기** 버튼을 누르세요.
            }

            @Step {
                새 위치에서 0.8초 머물러 점을 하나 만드세요. 이 점과 첫 번째 별자리 사이에는 **선이 없어야** 합니다.
            }

            @Step {
                같은 방법으로 점을 더 만들고, 두 번째 별자리 안의 기존 점에도 다시 연결해 보세요. 연결 후보는 현재 별자리 안으로 제한됩니다.
            }

            @Step {
                마지막으로 제어창의 **초기화**를 누르세요. 두 별자리의 점과 선이 모두 사라지고 개수 표시가 0으로 돌아갑니다.
            }

            @Step {
                **결과 확인**: 버튼으로 끄기와 다시 켜기, 서로 연결되지 않은 두 별자리, 초기화까지 확인했다면 성공입니다.
            }

            @Step {
                **문제가 생겼다면**: 두 별자리가 선으로 이어진다면 그리기를 끌 때 `finishCurrentConstellation()`이 호출되는지 확인하세요.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            그리기를 끄는 것과 초기화하는 것은 어떻게 다른가요?

            @Choice(isCorrect: true) {
                끄기는 새 입력만 막고 기존 별자리를 남기며, 초기화는 모든 점과 선을 지웁니다.

                @Justification(reaction: "맞습니다!") {
                    `finishCurrentConstellation`과 `reset`이 각각 그 역할을 맡습니다.
                }
            }

            @Choice(isCorrect: false) {
                둘은 같은 동작이며 버튼만 다릅니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    끄기는 지우지 않고 다음 시작을 새 별자리로 분리합니다.
                }
            }
        }
    }
}
