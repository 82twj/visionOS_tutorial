@Tutorial(time: 50) {
    @Intro(title: "공중에 별자리 그리기") {
        오른손 검지 끝이 한 위치에 0.8초 동안 머물면 점을 만들고, 주먹 손짓으로 그리기를 켜고 끄며 여러 별자리를 나누어 만드는 visionOS 앱을 완성합니다.
    }

    @Section(title: "앱과 몰입형 공간 구성하기") {
        @ContentAndMedia {
            먼저 SwiftUI 창에서 체험을 시작하고, 실제 손 추적은 혼합 몰입형 공간에서 실행되도록 두 Scene을 구성합니다.
        }

        @Steps {
            @Step {
                visionOS App 타깃의 최소 배포 버전을 visionOS 2.0 이상으로 설정하고 SwiftUI와 RealityKit을 사용합니다.
            }

            @Step {
                `Info.plist`에 `NSHandsTrackingUsageDescription`을 추가해 손 추적을 사용하는 이유를 설명합니다.

                @Code(name: "손 추적 사용 설명", file: HandsUsage.plist)
            }

            @Step {
                앱 진입점에 제어 창과 혼합 몰입형 공간을 선언합니다.

                @Code(name: "SwiftUI Scene 구성", file: AppScenes.swift)
            }
        }
    }

    @Section(title: "오른손 검지 끝 추적하기") {
        @ContentAndMedia {
            `ARKitSession`에 `HandTrackingProvider`를 실행하고 앵커 업데이트에서 오른손 검지 끝의 월드 좌표를 계산합니다.
        }

        @Steps {
            @Step {
                지원 여부와 손 추적 권한을 확인한 뒤 provider를 실행합니다. 사용자가 권한을 거부하면 추적을 시작하지 않고 상태를 창에 표시합니다.

                @Code(name: "손 추적 시작", file: StartHandTracking.swift)
            }

            @Step {
                `anchorUpdates` 비동기 시퀀스를 순회하면서 오른손 업데이트만 처리합니다.

                @Code(name: "오른손 앵커 업데이트", file: StreamHandAnchors.swift)
            }

            @Step {
                손 원점에서 검지 끝 관절까지의 두 변환을 곱합니다. 결과 행렬의 네 번째 열이 RealityKit 장면에서 사용할 월드 위치입니다.

                @Code(name: "검지 끝 월드 좌표", file: IndexFingerWorldPosition.swift)
            }
        }
    }

    @Section(title: "그리기 켜기와 끄기") {
        @ContentAndMedia {
            몰입형 공간은 안전하게 그리기 꺼짐 상태로 시작합니다. 사용자는 창의 버튼이나 오른손 주먹 손짓으로 점 생성 상태를 전환합니다.
        }

        @Steps {
            @Step {
                `AppModel`에 그리기 켜짐과 꺼짐 상태를 추가합니다. 제어 창에는 현재 상태와 같은 동작을 수행하는 버튼을 표시합니다.
            }

            @Step {
                오른손의 검지, 중지, 약지, 소지 끝이 각 손가락 관절보다 손목에 충분히 가까운지 비교해 주먹 여부를 판정합니다.
            }

            @Step {
                `FistHoldDetector`는 주먹을 0.6초 유지했을 때 상태 전환을 한 번만 방출합니다. 손을 다시 펼치기 전에는 같은 주먹에서 두 번째 전환이 발생하지 않습니다.
            }

            @Step {
                주먹이 감지되면 즉시 진행 중인 체류를 취소합니다. 그리기를 끌 때 현재 별자리를 마치므로 다시 켠 뒤의 첫 점은 이전 별자리와 연결되지 않습니다.
            }
        }
    }

    @Section(title: "체류 제스처 판정하기") {
        @ContentAndMedia {
            그리기가 켜진 동안 매 프레임 점을 찍지 않도록 검지가 작은 반경 안에서 정해진 시간 동안 유지되는지 검사합니다. 점을 만든 뒤에는 손가락이 충분히 멀어질 때까지 재입력을 막습니다.
        }

        @Steps {
            @Step {
                `idle`, `dwelling`, `coolingDown` 세 상태를 가진 `DwellDetector`를 만듭니다. 기본 체류 시간은 0.8초, 안정 반경은 1.5cm, 재활성 거리는 3cm입니다.
            }

            @Step {
                검지가 안정 반경을 벗어나면 새 위치에서 타이머를 다시 시작합니다. 반경 안에 머물렀다면 경과 시간을 0부터 1 사이의 진행률로 변환합니다.

                @Code(name: "체류 진행률 계산", file: UpdateDwell.swift)
            }

            @Step {
                체류 시간이 끝나면 후보 위치를 한 번만 확정하고 `coolingDown`으로 전환합니다. 손가락이 3cm 이상 움직여야 다음 체류를 시작합니다.
            }

            @Step {
                추적이 끊기면 진행 중이던 체류를 취소합니다. 이전 위치에서 타이머가 이어지지 않으므로 뜻하지 않은 점이 생기는 것을 막습니다.
            }
        }
    }

    @Section(title: "점과 선 렌더링하기") {
        @ContentAndMedia {
            체류가 확정될 때 구 엔티티를 추가하고, 두 번째 점부터는 이전 점과 새 점을 잇는 원기둥 엔티티를 추가합니다.
        }

        @Steps {
            @Step {
                새 점을 현재 별자리에 추가합니다. 같은 별자리의 이전 점이 있으면 두 위치로 구성된 선분도 함께 반환합니다.
            }

            @Step {
                선의 길이와 중점을 계산하고 RealityKit 원기둥을 두 점의 방향으로 회전합니다.

                @Code(name: "두 점 사이의 선", file: DrawLine.swift)
            }

            @Step {
                `RealityView`에 하나의 루트 엔티티를 추가합니다. 이후 생성하는 점, 선, 커서는 이 루트의 자식으로 관리합니다.

                @Code(name: "RealityKit 루트 엔티티", file: RealityScene.swift)
            }

            @Step {
                체류 진행률에 따라 검지 커서의 크기를 키워 사용자가 점이 확정될 시점을 예측할 수 있게 합니다.
            }
        }
    }

    @Section(title: "통합하고 확인하기") {
        @ContentAndMedia {
            코디네이터에서 추적, 체류 판정, 모델, 렌더러를 연결한 뒤 실제 기기에서 동작을 확인합니다.
        }

        @Steps {
            @Step {
                검지 위치와 단조 증가 시각을 `DwellDetector`에 전달합니다. 확정 위치가 생기면 모델에 점을 추가하고 렌더러를 갱신합니다.

                @Code(name: "입력 파이프라인 연결", file: CoordinateInput.swift)
            }

            @Step {
                그리기 끄기와 종료 동작은 진행 중인 체류를 먼저 취소합니다. 초기화 버튼은 모든 별자리와 RealityKit 엔티티를 함께 비우며, 몰입형 공간을 닫을 때는 ARKit 세션도 중단합니다.
            }

            @Step {
                Apple Vision Pro에서 혼합 몰입형 공간을 열고 그리기가 꺼진 상태인지 확인합니다. 오른손 주먹을 0.6초 유지해 그리기를 켠 뒤, 한 지점에 약 0.8초 머물러 첫 점을 만들고 3cm 이상 이동한 다음 다시 머물러 선을 만듭니다.
            }

            @Step {
                주먹으로 그리기를 끈 뒤 손을 움직여도 점이 생기지 않는지 확인합니다. 다시 켜서 만드는 첫 점이 이전 별자리와 연결되지 않는지, 초기화 후 모든 점과 선이 사라지는지도 확인합니다.
            }
        }
    }
}
