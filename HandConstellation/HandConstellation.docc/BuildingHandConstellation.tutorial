@Tutorial(time: 150) {
    @Intro(title: "공중에 별자리 그리기") {
        Xcode가 만들어 준 첫 코드에서 출발해, 오른손 검지의 체류로 점을 찍고 주먹 손짓으로 여러 별자리를 나누어 만드는 visionOS 앱을 완성합니다. 각 단계의 오른쪽 코드에서 파란색으로 표시된 줄만 새로 입력하세요.

        @Image(source: constellation-hero.png, alt: "오른손 검지로 두 개의 빛나는 별자리를 그리고 그리기 상태를 제어하는 Hand Constellation 앱")
    }

    @Section(title: "프로젝트를 만들고 첫 코드 읽기") {
        @ContentAndMedia {
            완성 코드를 붙여 넣기 전에 Xcode가 자동으로 만든 두 Swift 파일을 먼저 읽습니다. 그런 다음 손 추적 권한을 Xcode 화면에서 추가하고, 마지막에만 `Info.plist`의 저장 형태를 확인합니다.

            @Image(source: scene-structure.png, alt: "SwiftUI 제어 창에서 혼합 몰입형 공간의 RealityKit 장면을 여는 구조")
        }

        @Steps {
            @Step {
                Xcode를 열고 **Create New Project**를 선택합니다. **visionOS > App** 템플릿을 고른 다음 **Next**를 누르세요.
            }

            @Step {
                Product Name에 `HandConstellation`을 입력합니다. Interface는 **SwiftUI**, Language는 **Swift**를 선택하고 프로젝트를 저장하세요.
            }

            @Step {
                왼쪽 Project navigator에서 `ContentView.swift`를 엽니다. 아래 코드는 Xcode가 새 프로젝트에 넣어 준 시작 코드입니다. 아직 수정하지 말고 `body` 안의 `VStack`이 화면 내용을 만든다는 점만 확인하세요.

                @Code(name: "ContentView.swift", file: S1-ContentView-00.swift, reset: true)
            }

            @Step {
                `import SwiftUI`는 `Text`, `Image`, `VStack` 같은 화면 구성 요소를 사용하게 합니다. `struct ContentView: View`는 이 타입이 하나의 SwiftUI 화면임을 뜻합니다.

                `#Preview`는 앱을 실행하지 않고도 Xcode Canvas에서 화면을 미리 보여 줍니다. 이 단계에서는 코드를 바꾸지 않습니다.
            }

            @Step {
                `HandConstellationApp.swift`도 엽니다. `@main`이 붙은 타입이 앱의 시작점이고, `WindowGroup` 안의 `ContentView()`가 처음 표시할 창입니다.

                @Code(name: "HandConstellationApp.swift", file: S1-App-00.swift, reset: true)
            }

            @Step {
                상단 실행 대상에서 Apple Vision Pro Simulator를 선택하고 **Run**을 누르세요. `Hello, world!` 창이 보이면 시작 프로젝트가 정상입니다.
            }

            @Step {
                Project navigator 맨 위의 파란 프로젝트 아이콘을 선택한 뒤 TARGETS에서 **HandConstellation**을 선택합니다. **General** 탭의 Minimum Deployments가 visionOS 2.0 이상인지 확인하세요.
            }

            @Step {
                같은 타깃의 **Info** 탭을 엽니다. **Custom visionOS Target Properties**에서 `+`를 누르고 **Privacy - Hand Tracking Usage Description**을 선택하세요. 이 작업은 앱이 처음 손 추적을 요청할 때 시스템이 보여 줄 설명 항목을 만듭니다.
            }

            @Step {
                Value에 `검지 끝의 움직임을 감지해 공중에 별자리 점과 선을 그리기 위해 손 추적을 사용합니다.`라고 입력하세요. 기능과 사용 목적을 사용자가 이해할 수 있는 문장으로 쓰는 것이 중요합니다.
            }

            @Step {
                이제 `Info.plist`를 **Open As > Source Code**로 보면 방금 입력한 항목이 아래 두 줄로 저장되어 있습니다. `<key>`를 직접 외워서 먼저 입력하는 단계가 아니라, Xcode의 Info 화면에서 한 설정이 XML로 어떻게 보이는지 확인하는 단계입니다.

                @Code(name: "Info.plist", file: S1-Info-01.plist, previousFile: S1-Info-00.plist)
            }
        }
    }

    @Section(title: "앱의 공통 상태 만들기") {
        @ContentAndMedia {
            창과 몰입형 공간이 같은 값을 공유할 수 있도록 `AppModel`을 만듭니다. 새 Swift 파일의 초기 상태에서 시작해 타입과 속성을 작은 단위로 추가합니다.

            @Image(source: drawing-toggle.png, alt: "그리기 꺼짐과 켜짐 상태를 하나의 앱 모델에서 공유하는 구조")
        }

        @Steps {
            @Step {
                Project navigator에서 폴더를 보조 클릭하고 **New File > Swift File**을 선택해 `AppModel.swift`를 만드세요. Xcode가 넣은 `import Foundation`만 남아 있는 상태를 먼저 확인합니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-00.swift, reset: true)
            }

            @Step {
                `Foundation`을 `Observation`으로 바꾸고 `@MainActor`, `@Observable`을 추가한 뒤 빈 `AppModel` 클래스를 선언하세요. `@Observable` 덕분에 값이 바뀌면 SwiftUI 화면도 갱신됩니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-01.swift, previousFile: S2-AppModel-00.swift)
            }

            @Step {
                몰입형 공간의 세 상태를 나타내는 `ImmersiveSpaceState`를 추가하세요. 닫힘, 전환 중, 열림을 따로 두면 시작 버튼을 연속으로 누르는 일을 막을 수 있습니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-02.swift, previousFile: S2-AppModel-01.swift)
            }

            @Step {
                손 추적 진행 상태를 나타내는 `TrackingStatus`를 추가하세요. 권한 요청, 추적 중, 지원하지 않음, 거부, 오류를 화면에 구분해서 알릴 수 있습니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-03.swift, previousFile: S2-AppModel-02.swift)
            }

            @Step {
                점 생성이 가능한지를 나타내는 `DrawingState`를 추가하세요. 앱은 안전하게 `.disabled`로 시작하므로 몰입형 공간을 여는 손동작이 곧바로 점이 되지 않습니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-04.swift, previousFile: S2-AppModel-03.swift)
            }

            @Step {
                몰입형 공간 ID와 세 상태 저장 속성을 추가하세요. `drawingState`의 초기값이 `.disabled`인지 다시 확인합니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-05.swift, previousFile: S2-AppModel-04.swift)
            }

            @Step {
                점 개수, 별자리 개수, 주먹 유지 진행률, 초기화 요청 번호를 차례로 저장합니다. 이 값들은 나중에 창의 상태 표시와 RealityKit 장면 초기화에 쓰입니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-06.swift, previousFile: S2-AppModel-05.swift)
            }

            @Step {
                `isTransitioning`과 `isDrawingEnabled` 계산 속성을 추가하세요. 여러 화면에서 enum 비교를 반복하지 않고 읽기 쉬운 Boolean으로 사용할 수 있습니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-07.swift, previousFile: S2-AppModel-06.swift)
            }

            @Step {
                그리기 상태를 직접 지정하는 메서드, 반대로 전환하는 메서드, 초기화를 요청하는 메서드를 추가합니다. 상태를 바꾸는 경로를 이 메서드들로 모으면 창 버튼과 주먹 손짓이 같은 규칙을 사용합니다.

                @Code(name: "AppModel.swift", file: S2-AppModel-08.swift, previousFile: S2-AppModel-07.swift)
            }
        }
    }

    @Section(title: "창과 몰입형 공간 연결하기") {
        @ContentAndMedia {
            기본 `ContentView`를 제어 창으로 바꾸고, 앱 진입점에 혼합 몰입형 공간을 추가합니다. 처음에는 시작·종료와 그리기 전환에 필요한 최소 UI만 만듭니다.

            @Image(source: scene-structure.png, alt: "제어 창과 혼합 몰입형 공간이 AppModel을 공유하는 구조")
        }

        @Steps {
            @Step {
                `HandConstellationApp.swift`에서 `AppModel` 인스턴스를 상태로 만드세요. 앱이 살아 있는 동안 하나의 인스턴스가 유지됩니다.

                @Code(name: "HandConstellationApp.swift", file: S3-App-01.swift, previousFile: S1-App-00.swift)
            }

            @Step {
                `ContentView()`를 `ControlView()`로 바꾸고 `.environment(appModel)`을 붙이세요. 이제 제어 창의 하위 화면이 공통 상태를 읽고 수정할 수 있습니다.

                @Code(name: "HandConstellationApp.swift", file: S3-App-02.swift, previousFile: S3-App-01.swift)
            }

            @Step {
                `WindowGroup` 아래에 `ImmersiveSpace`를 추가하고 같은 `appModel`을 전달하세요. 마지막 줄은 현실 공간을 함께 볼 수 있는 `.mixed` 스타일을 지정합니다.

                @Code(name: "HandConstellationApp.swift", file: S3-App-03.swift, previousFile: S3-App-02.swift)
            }

            @Step {
                `ContentView.swift`의 이름을 `ControlView.swift`로 바꾸고 struct 이름과 Preview도 `ControlView`로 바꾸세요. 우선 Xcode 시작 UI는 그대로 둡니다.

                @Code(name: "ControlView.swift", file: S3-Control-01.swift, previousFile: S1-ContentView-00.swift)
            }

            @Step {
                `ControlView` 안에 `AppModel`, `openImmersiveSpace`, `dismissImmersiveSpace` 환경 값을 추가하세요. 버튼을 눌렀을 때 공간을 열고 닫기 위한 세 입력입니다.

                @Code(name: "ControlView.swift", file: S3-Control-02.swift, previousFile: S3-Control-01.swift)
            }

            @Step {
                기존 `VStack` 내용을 앱 제목과 짧은 사용 설명으로 교체하세요. 이 단계에서는 아직 버튼 동작을 연결하지 않습니다.

                @Code(name: "ControlView.swift", file: S3-Control-03.swift, previousFile: S3-Control-02.swift)
            }

            @Step {
                첫 번째 버튼을 추가하세요. 공간이 닫혀 있으면 `openExperience()`를, 열려 있으면 `closeExperience()`를 호출하도록 분기합니다.

                @Code(name: "ControlView.swift", file: S3-Control-04.swift, previousFile: S3-Control-03.swift)
            }

            @Step {
                두 번째 버튼으로 `appModel.toggleDrawing()`을 호출하세요. 몰입형 공간이 열리고 손 추적 중일 때만 사용할 수 있게 합니다.

                @Code(name: "ControlView.swift", file: S3-Control-05.swift, previousFile: S3-Control-04.swift)
            }

            @Step {
                `openExperience()`를 추가하세요. 공간을 열기 직전에 그리기를 끄고 전환 중 상태로 바꾼 뒤, 성공할 때만 `.open`을 저장합니다.

                @Code(name: "ControlView.swift", file: S3-Control-06.swift, previousFile: S3-Control-05.swift)
            }

            @Step {
                `closeExperience()`를 추가하세요. 먼저 그리기를 꺼 진행 중인 입력을 막고, 공간을 닫은 뒤 상태를 초기값으로 돌립니다.

                @Code(name: "ControlView.swift", file: S3-Control-07.swift, previousFile: S3-Control-06.swift)
            }
        }
    }

    @Section(title: "오른손 검지 끝 추적하기") {
        @ContentAndMedia {
            ARKit 세션을 시작하고 오른손 검지 끝을 RealityKit에서 사용할 월드 위치로 바꿉니다. 권한 확인과 좌표 변환을 한 단계씩 나누어 추가합니다.

            @Image(source: hand-tracking.png, alt: "오른손 골격의 검지 끝 관절을 월드 좌표로 변환하는 과정")
        }

        @Steps {
            @Step {
                **New File > Swift File**로 `HandTrackingService.swift`를 만드세요. 시작 코드의 `Foundation` import만 먼저 확인합니다.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-00.swift, reset: true)
            }

            @Step {
                `ARKit`과 `simd`를 import하고, 지원하지 않는 환경과 권한 거부를 구분할 오류 enum을 추가하세요.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-01.swift, previousFile: S4-Hand-00.swift)
            }

            @Step {
                `@MainActor` 클래스와 `HandTrackingProvider`, `ARKitSession` 속성을 추가합니다. provider는 손 앵커를 만들고 session은 권한과 실행 수명을 관리합니다.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-02.swift, previousFile: S4-Hand-01.swift)
            }

            @Step {
                `start()`의 첫 줄에서 현재 실행 환경이 손 추적을 지원하는지 검사하세요. Simulator나 미지원 환경이면 여기서 명확한 오류를 냅니다.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-03.swift, previousFile: S4-Hand-02.swift)
            }

            @Step {
                현재 손 추적 권한 상태를 조회하세요. 아직 사용자가 선택하지 않았다면 `.notDetermined`가 됩니다.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-04.swift, previousFile: S4-Hand-03.swift)
            }

            @Step {
                상태가 `.notDetermined`일 때만 시스템 권한 창을 요청하고, 허용되지 않았다면 오류를 던지세요. 마지막에 session에 provider를 전달해 추적을 시작합니다.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-05.swift, previousFile: S4-Hand-04.swift)
            }

            @Step {
                `rightIndexFingerTipPosition` 메서드를 추가하고 오른손인지, 앵커가 추적 중인지, 손 골격이 있는지를 먼저 확인하세요. 조건 하나라도 실패하면 위치를 만들지 않습니다.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-06.swift, previousFile: S4-Hand-05.swift)
            }

            @Step {
                손 골격에서 `.indexFingerTip` 관절을 꺼내고, 그 관절도 추적 중인지 확인하세요.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-07.swift, previousFile: S4-Hand-06.swift)
            }

            @Step {
                손 앵커의 월드 변환과 검지 관절의 로컬 변환을 곱하세요. 결과 행렬의 네 번째 열에서 x, y, z를 꺼내면 월드 위치가 됩니다. 끝에 `stop()`도 추가합니다.

                @Code(name: "HandTrackingService.swift", file: S4-Hand-08.swift, previousFile: S4-Hand-07.swift)
            }
        }
    }

    @Section(title: "머무름을 한 번의 점으로 바꾸기") {
        @ContentAndMedia {
            매 프레임 점을 찍지 않고, 검지가 작은 반경 안에서 0.8초 머물렀을 때 한 번만 확정합니다. 확정 직후에는 3cm 이상 움직일 때까지 다음 입력을 막습니다.

            @Image(source: dwell-progress.png, alt: "검지 커서가 0초부터 0.8초까지 커지다가 별 점으로 확정되는 네 단계")
        }

        @Steps {
            @Step {
                `DwellDetector.swift`를 만들고 `Foundation`, `simd`를 import한 뒤 빈 struct를 선언하세요.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-00.swift, reset: true)
            }

            @Step {
                사용자에게 보여 줄 `Phase`와 한 번의 계산 결과를 담는 `Snapshot`을 추가하세요. `committedPosition`이 nil이 아닐 때만 점을 만듭니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-01.swift, previousFile: S5-Dwell-00.swift)
            }

            @Step {
                내부 상태 `State`를 추가하세요. `dwelling`은 시작 위치와 시간을, `coolingDown`은 마지막 확정 위치를 기억합니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-02.swift, previousFile: S5-Dwell-01.swift)
            }

            @Step {
                0.8초, 1.5cm, 3cm의 기준값과 현재 상태를 저장하고 initializer에서 값을 받으세요.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-03.swift, previousFile: S5-Dwell-02.swift)
            }

            @Step {
                `update`를 만들고 잘못된 좌표나 시간이 들어오면 `.idle`로 돌아가세요. 추적이 끊긴 프레임의 시간이 다음 체류로 이어지는 것을 막습니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-04.swift, previousFile: S5-Dwell-03.swift)
            }

            @Step {
                `.idle`에서는 현재 위치와 시간을 체류 시작점으로 저장하고 진행률 0을 반환하세요. 아직 점은 확정하지 않습니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-05.swift, previousFile: S5-Dwell-04.swift)
            }

            @Step {
                `.dwelling`에서 검지가 1.5cm 반경을 벗어나면 새 위치에서 타이머를 다시 시작하세요. 손을 이동하는 중에는 점이 찍히지 않게 하는 핵심 조건입니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-06.swift, previousFile: S5-Dwell-05.swift)
            }

            @Step {
                반경 안에 머물렀다면 경과 시간과 0...1 진행률을 계산하세요. 0.8초에 도달하기 전에는 진행률만 반환합니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-07.swift, previousFile: S5-Dwell-06.swift)
            }

            @Step {
                0.8초가 지나면 중심 위치를 한 번 확정하고 `.coolingDown`으로 전환하세요. 이 상태 전환 때문에 같은 위치에서 점이 계속 생기지 않습니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-08.swift, previousFile: S5-Dwell-07.swift)
            }

            @Step {
                `.coolingDown`에서는 마지막 점에서 3cm 이상 이동했을 때만 새 체류를 시작하세요. 마지막으로 추적 손실과 전체 초기화 메서드를 추가합니다.

                @Code(name: "DwellDetector.swift", file: S5-Dwell-09.swift, previousFile: S5-Dwell-08.swift)
            }
        }
    }

    @Section(title: "주먹으로 그리기를 켜고 끄기") {
        @ContentAndMedia {
            손을 움직여 종료 버튼을 누를 필요가 없도록 오른손 주먹을 0.6초 유지하면 그리기 상태를 전환합니다. 주먹을 펴기 전에는 한 번만 동작해야 합니다.

            @Image(source: drawing-toggle.png, alt: "오른손 주먹을 0.6초 유지해 그리기 꺼짐과 켜짐 상태를 전환하는 모습")
        }

        @Steps {
            @Step {
                `FistHoldDetector.swift`를 만들고 `Foundation`을 import한 빈 struct에서 시작하세요.

                @Code(name: "FistHoldDetector.swift", file: S6-Fist-00.swift, reset: true)
            }

            @Step {
                준비, 유지 중, 손을 펴기 기다림의 세 phase와 진행률·전환 여부를 담는 snapshot을 추가합니다.

                @Code(name: "FistHoldDetector.swift", file: S6-Fist-01.swift, previousFile: S6-Fist-00.swift)
            }

            @Step {
                시작 시각을 기억하는 내부 상태와 0.6초 기준값을 추가하세요.

                @Code(name: "FistHoldDetector.swift", file: S6-Fist-02.swift, previousFile: S6-Fist-01.swift)
            }

            @Step {
                `update`에서 시간이 잘못되면 초기화하고, 손이 주먹이 아니면 `.ready`로 돌아가세요. 손을 다시 펴야 다음 전환이 가능해집니다.

                @Code(name: "FistHoldDetector.swift", file: S6-Fist-03.swift, previousFile: S6-Fist-02.swift)
            }

            @Step {
                `.ready`에서 타이머를 시작하고 `.holding`에서 진행률을 계산하세요. 0.6초 전에는 `didToggle`을 false로 유지합니다.

                @Code(name: "FistHoldDetector.swift", file: S6-Fist-04.swift, previousFile: S6-Fist-03.swift)
            }

            @Step {
                0.6초가 지나면 `.waitingForRelease`로 바꾸며 딱 한 번 true를 반환하세요. 같은 주먹을 계속 유지하는 동안에는 다시 전환하지 않습니다.

                @Code(name: "FistHoldDetector.swift", file: S6-Fist-05.swift, previousFile: S6-Fist-04.swift)
            }

            @Step {
                `HandTrackingService`에 `isRightHandFist`를 추가하세요. 먼저 오른손, 추적 상태, 손 골격, 손목 관절을 확인하고 네 손가락의 끝과 마디 이름을 배열로 준비합니다.

                @Code(name: "HandTrackingService.swift", file: S6-Hand-09.swift, previousFile: S4-Hand-08.swift)
            }

            @Step {
                각 손가락 끝이 손목에서 마디보다 지나치게 멀지 않은지 비율로 검사하세요. 네 손가락이 모두 접혔을 때만 true를 반환합니다.

                @Code(name: "HandTrackingService.swift", file: S6-Hand-10.swift, previousFile: S6-Hand-09.swift)
            }
        }
    }

    @Section(title: "점, 별자리, 선을 모델링하기") {
        @ContentAndMedia {
            좌표 배열을 별자리 단위로 나누어 저장합니다. 그리기를 끌 때 현재 별자리를 끝내 두 번째 별자리의 첫 점이 이전 별자리와 연결되지 않게 합니다.

            @Image(source: constellation-rendering.png, alt: "노란 구 형태의 별 점과 파란 원기둥 선분을 RealityKit 루트 엔티티 아래에 그린 모습")
        }

        @Steps {
            @Step {
                `ConstellationModel.swift`를 만들고 `simd`를 import한 빈 struct에서 시작하세요.

                @Code(name: "ConstellationModel.swift", file: S7-Model-00.swift, reset: true)
            }

            @Step {
                두 점을 잇는 `Segment`와 점 추가 결과 enum을 추가하세요. 실패 이유를 구분해 두면 UI에서 필요한 경우 알맞은 안내를 할 수 있습니다.

                @Code(name: "ConstellationModel.swift", file: S7-Model-01.swift, previousFile: S7-Model-00.swift)
            }

            @Step {
                별자리별 좌표를 저장하는 이중 배열과 `isStartingNewConstellation`을 추가하세요. 점 개수와 별자리 개수 계산 속성도 만듭니다.

                @Code(name: "ConstellationModel.swift", file: S7-Model-02.swift, previousFile: S7-Model-01.swift)
            }

            @Step {
                최소 점 간격과 최대 점 개수를 initializer로 받으세요. 사용자가 거의 같은 위치에 점을 겹쳐 만드는 일과 무제한 생성을 막습니다.

                @Code(name: "ConstellationModel.swift", file: S7-Model-03.swift, previousFile: S7-Model-02.swift)
            }

            @Step {
                `addPoint`의 시작에 잘못된 좌표, 최대 개수, 너무 가까운 위치를 거르는 guard를 추가하세요.

                @Code(name: "ConstellationModel.swift", file: S7-Model-04.swift, previousFile: S7-Model-03.swift)
            }

            @Step {
                새 별자리의 첫 점이면 새 배열을 만들고, 아니면 마지막 배열에 점을 붙이세요. 이전 점이 있을 때만 선택적 선분을 반환합니다.

                @Code(name: "ConstellationModel.swift", file: S7-Model-05.swift, previousFile: S7-Model-04.swift)
            }

            @Step {
                `finishCurrentConstellation()`은 다음 점을 새 별자리로 표시하고, `reset()`은 모든 좌표를 지웁니다. 그리기 끄기와 전체 초기화는 서로 다른 동작입니다.

                @Code(name: "ConstellationModel.swift", file: S7-Model-06.swift, previousFile: S7-Model-05.swift)
            }

            @Step {
                `ConstellationRenderer.swift`를 만들고 RealityKit root, 점 컨테이너, 선 컨테이너를 추가하세요. 모든 엔티티를 한 root 아래에 두면 장면 정리가 쉬워집니다.

                @Code(name: "ConstellationRenderer.swift", file: S7-Renderer-00.swift, reset: true)
            }

            @Step {
                구 mesh와 점·선 material, 검지 cursor를 initializer에서 만드세요. cursor는 체류 중일 때만 켜기 위해 처음에는 비활성화합니다.

                @Code(name: "ConstellationRenderer.swift", file: S7-Renderer-01.swift, previousFile: S7-Renderer-00.swift)
            }

            @Step {
                체류 진행률에 따라 cursor를 키우는 메서드와 확정된 점을 추가하는 메서드를 만드세요.

                @Code(name: "ConstellationRenderer.swift", file: S7-Renderer-02.swift, previousFile: S7-Renderer-01.swift)
            }

            @Step {
                두 점의 거리로 원기둥 길이를 만들고, 중점에 놓은 뒤 두 점 방향으로 회전하세요. 마지막으로 점과 선을 모두 지우는 `reset()`을 추가합니다.

                @Code(name: "ConstellationRenderer.swift", file: S7-Renderer-03.swift, previousFile: S7-Renderer-02.swift)
            }
        }
    }

    @Section(title: "입력 흐름을 연결하고 확인하기") {
        @ContentAndMedia {
            지금까지 만든 추적, 주먹 유지, 체류, 모델, 렌더러를 코디네이터에서 순서대로 연결합니다. 그리기 꺼짐 상태가 점 생성보다 먼저 검사되는 것이 가장 중요합니다.

            @Image(source: complete-experience.png, alt: "그리기가 꺼진 상태에서 연결선 없이 분리된 두 별자리가 남아 있는 완성 화면")
        }

        @Steps {
            @Step {
                `ImmersiveCoordinator.swift`를 만들고 다섯 구성 요소를 속성으로 준비하세요. initializer에서는 같은 설정값으로 detector, model, renderer를 만듭니다.

                @Code(name: "ImmersiveCoordinator.swift", file: S8-Coordinator-00.swift, reset: true)
            }

            @Step {
                `run`에서 손 추적을 시작하고 `anchorUpdates`를 순회하세요. 오른손 앵커만 `process`로 보내고 task가 취소되면 반복을 끝냅니다.

                @Code(name: "ImmersiveCoordinator.swift", file: S8-Coordinator-01.swift, previousFile: S8-Coordinator-00.swift)
            }

            @Step {
                `process(anchor:)`의 맨 앞에서 주먹을 판정하세요. 주먹을 유지하는 동안에는 `cancelDwell()`을 먼저 호출하므로 상태 전환 손짓 자체가 별자리 점이 되지 않습니다.

                @Code(name: "ImmersiveCoordinator.swift", file: S8-Coordinator-02.swift, previousFile: S8-Coordinator-01.swift)
            }

            @Step {
                주먹 처리가 끝난 다음에만 `isDrawingEnabled`를 검사하세요. 꺼져 있으면 체류와 cursor를 취소하고 즉시 반환합니다. 이 guard가 손을 종료 버튼 쪽으로 움직일 때 생길 수 있는 점을 막습니다.

                @Code(name: "ImmersiveCoordinator.swift", file: S8-Coordinator-03.swift, previousFile: S8-Coordinator-02.swift)
            }

            @Step {
                검지 위치를 `DwellDetector`에 전달하고 cursor를 갱신하세요. `committedPosition`이 생긴 프레임에서만 모델과 렌더러에 새 점을 보냅니다.

                @Code(name: "ImmersiveCoordinator.swift", file: S8-Coordinator-04.swift, previousFile: S8-Coordinator-03.swift)
            }

            @Step {
                그리기 상태가 꺼짐으로 바뀌면 체류를 취소하고 `finishCurrentConstellation()`을 호출하세요. 다음에 다시 켜서 찍는 첫 점은 새 배열에서 시작합니다.

                @Code(name: "ImmersiveCoordinator.swift", file: S8-Coordinator-05.swift, previousFile: S8-Coordinator-04.swift)
            }

            @Step {
                `ImmersiveView.swift`에서 `RealityView`에 renderer의 root를 추가하고, `.task`에서 코디네이터를 실행하세요. 상태 변경과 화면 종료도 코디네이터에 전달합니다.

                @Code(name: "ImmersiveView.swift", file: S8-ImmersiveView.swift, reset: true)
            }

            @Step {
                Apple Vision Pro에서 앱을 실행하고 손 추적 권한을 허용하세요. **별자리 그리기 시작**을 선택한 직후에는 **그리기 꺼짐**이어야 하며 손을 움직여도 점이 생기지 않아야 합니다.
            }

            @Step {
                오른손 주먹을 0.6초 유지해 그리기를 켜세요. 검지를 한 위치에 0.8초 머물러 첫 점을 만들고, 3cm 이상 옮긴 뒤 다시 머물러 두 번째 점과 선을 만드세요.
            }

            @Step {
                점 다섯 개로 첫 별자리를 만든 뒤 주먹을 유지해 그리기를 끄세요. 손을 자유롭게 움직여도 여섯 번째 점이 생기지 않는지 확인합니다.
            }

            @Step {
                다시 주먹을 유지해 그리기를 켜고 한 점을 만드세요. 새 점과 첫 별자리 사이에 선이 없다면 여러 별자리 분리가 올바르게 작동한 것입니다. 마지막으로 **초기화**를 눌러 모든 점과 선이 사라지는지 확인하세요.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            손 추적 권한 설명을 추가하는 첫 번째 행동은 무엇인가요?

            @Choice(isCorrect: true) {
                Target의 Info 탭에서 Privacy - Hand Tracking Usage Description 항목을 추가합니다.

                @Justification(reaction: "맞습니다!") {
                    Xcode 화면에서 사람이 읽는 항목을 추가한 뒤, 필요할 때만 XML 저장 형태를 확인합니다.
                }
            }

            @Choice(isCorrect: false) {
                의미를 모른 채 `<key>`부터 Swift 파일에 입력합니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    `<key>`는 Swift 코드가 아니라 `Info.plist`의 Source Code 표현입니다.
                }
            }
        }

        @MultipleChoice {
            같은 위치에서 점이 반복해서 생기는 것을 막는 상태는 무엇인가요?

            @Choice(isCorrect: false) {
                `idle`

                @Justification(reaction: "다시 생각해 보세요.") {
                    `idle`은 아직 체류 후보가 없는 초기 상태입니다.
                }
            }

            @Choice(isCorrect: true) {
                `coolingDown`

                @Justification(reaction: "맞습니다!") {
                    점을 만든 뒤 충분히 멀리 이동할 때까지 다음 입력을 막습니다.
                }
            }
        }

        @MultipleChoice {
            상태 전환을 위해 주먹을 쥔 순간 점이 생기지 않는 이유는 무엇인가요?

            @Choice(isCorrect: true) {
                주먹을 처리할 때 진행 중인 체류를 먼저 취소하고 위치 입력으로 넘어가지 않기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    제어 손짓과 그리기 입력의 우선순위를 분리했습니다.
                }
            }

            @Choice(isCorrect: false) {
                주먹을 쥐면 ARKit 세션이 자동으로 종료되기 때문입니다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    세션은 유지되고 그리기 상태와 체류 판정만 바뀝니다.
                }
            }
        }
    }
}
