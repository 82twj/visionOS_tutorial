@Tutorial(time: 6) {
    @Intro(title: "새 파일 준비하기: 설정값과 입력 감지기") {
        **이번 단계에서 만들 것**: 비어 있는 Swift 파일 세 개입니다. 기존 파일은 건드리지 않습니다.

        점 체류와 기존 점 연결은 서로 다른 일이므로 작은 순수 Swift 타입으로 나눕니다. 함께 쓰는 숫자는 설정 파일에 모읍니다.

        @Image(source: xcode-new-file.png, alt: "새 파일 만들기 창에서 visionOS 그룹과 Swift File 템플릿이 강조된 화면")
    }

    @Section(title: "세 파일의 책임 비교하기") {
        @Steps {
            @Step {
                `ConstellationConfiguration.swift`를 만드세요. 체류 시간, 거리와 렌더링 크기를 모읍니다.

                @Code(name: "ConstellationConfiguration.swift", file: C04-T01-Configuration-00.swift, reset: true)
            }

            @Step {
                `DwellDetector.swift`를 만드세요. 검지가 새 위치에 머무는 시간을 잽니다.

                @Code(name: "DwellDetector.swift", file: C04-T01-DwellDetector-00.swift, reset: true)
            }

            @Step {
                `ExistingPointConnectionDetector.swift`를 만드세요. 현재 별자리의 모든 기존 점 중 가장 가까운 목표를 고정하고 연결 체류를 판단합니다.

                @Code(name: "ExistingPointConnectionDetector.swift", file: C04-T01-ExistingPointConnectionDetector-00.swift, reset: true)
            }

            @Step {
                **결과 확인**: Project navigator에 세 파일이 모두 보이고 HandConstellation 타깃에 포함되어 있으면 성공입니다.
            }
        }
    }
}
