@Tutorial(time: 8) {
    @Intro(title: "버튼 중심 제어창 완성하기") {
        **이번 단계에서 만들 것**: 상태와 조작법을 보여 주고 몰입형 공간과 그리기를 버튼으로 제어하는 `ControlView`입니다.

        @Image(source: scene-structure.png, alt: "SwiftUI 제어창과 혼합 몰입형 공간이 AppModel을 공유하는 구조")
    }

    @Section(title: "사용자가 알아야 할 정보 정하기") {
        @Steps {
            @Step {
                상단에는 검지 체류, 3cm 이동과 기존 점 재연결의 세 단계만 안내합니다. 사용하지 않는 주먹 조작 설명은 표시하지 않습니다.
            }

            @Step {
                별자리·점·선 개수와 손 추적 상태를 한 줄에 표시합니다. 오류가 있으면 상태 문장이 다음 행동을 설명합니다.
            }

            @Step {
                상황별 안내 카드는 새 점, 연결 중, 연결 완료, 중복 선과 너무 가까운 입력을 구분합니다.
            }

            @Step {
                그리기 버튼은 현재 상태에 따라 **그리기 켜기** 또는 **그리기 끄기**가 됩니다. 이것이 유일한 그리기 전환 조작입니다.
            }
        }
    }

    @Section(title: "완성 제어창 추가하기") {
        @Steps {
            @Step {
                시작·종료, 그리기 전환과 초기화 버튼을 포함한 완성 제어창을 추가하세요. 긴 상단 문구는 두 줄에서도 잘리지 않도록 고정합니다.

                @Code(name: "ControlView.swift", file: C02-T04-ControlView-14.swift, previousFile: C02-T03-ControlView-01.swift)
            }

            @Step {
                **결과 확인**: Simulator에서 세 단계 조작법, 상태 카드, 그리기 상태와 버튼 세 개가 보이고 주먹 안내나 손짓 진단이 없어야 합니다.
            }

            @Step {
                **문제가 생겼다면**: 그리기 버튼이 눌리지 않으면 몰입형 공간이 열려 있고 추적 상태가 `.tracking`인지 확인하세요.
            }
        }
    }
}
