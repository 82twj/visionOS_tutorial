@Tutorial(time: 16) {
    @Intro(title: "버튼 중심 제어창 완성하기") {
        **시작 상태**: `AppModel.swift`가 빌드되고, 템플릿의 `ContentView.swift`와 `HandConstellationApp.swift`가 남아 있습니다.

        **이번 단계에서 만들 것**: 템플릿 화면을 `ControlView`로 이름 바꾸고 공통 모델을 앱 진입점에 연결한 뒤, 상태와 조작 버튼을 단계적으로 추가합니다.

        @Image(source: scene-structure.png, alt: "SwiftUI 제어창과 혼합 몰입형 공간이 AppModel을 공유하는 구조")
    }

    @Section(title: "화면 이름과 공통 환경 연결하기") {
        @ContentAndMedia {
            앱 진입점에서 `AppModel`을 한 번 만들고 environment로 전달하면 현재 창과 나중에 추가할 몰입형 공간이 같은 인스턴스를 읽습니다.
        }

        @Steps {
            @Step {
                Project navigator에서 `ContentView.swift`를 `ControlView.swift`로 바꾸고, 타입과 Preview 이름도 `ControlView`로 바꾸세요.

                @Code(name: "ControlView.swift", file: C02-T03-ControlView-00.swift, previousFile: C01-T03-ContentView-00.swift)
            }

            @Step {
                `AppModel`, `openImmersiveSpace`, `dismissImmersiveSpace` 환경 값을 추가하고 Preview에 모델을 전달하세요.

                @Code(name: "ControlView.swift", file: C02-T03-ControlView-01.swift, previousFile: C02-T03-ControlView-00.swift)
            }

            @Step {
                앱 진입점에 `@State` 모델을 만들고 `ControlView`로 이름을 바꾸세요.

                @Code(name: "HandConstellationApp.swift", file: C02-T03-HandConstellationApp-01.swift, previousFile: C01-T03-HandConstellationApp-00.swift)
            }

            @Step {
                모델을 environment로 전달하고 창 크기를 내용에 맞추세요.

                @Code(name: "HandConstellationApp.swift", file: C02-T03-HandConstellationApp-02.swift, previousFile: C02-T03-HandConstellationApp-01.swift)
            }

            @Step {
                **중간 확인**: 빌드하고 Simulator를 실행하세요. 창에는 여전히 `Hello, world!`가 보여야 합니다. `ContentView`를 찾을 수 없다는 오류가 나면 프로젝트 전체 검색으로 남은 이름을 찾으세요.
            }
        }
    }

    @Section(title: "정보와 조작을 단계적으로 추가하기") {
        @ContentAndMedia {
            화면을 안내, 상태, 조작 순으로 확장합니다. 먼저 정적인 안내를 Preview에서 확인하고, 공유 상태 표시와 공간 전환 버튼을 차례로 연결합니다.
        }

        @Steps {
            @Step {
                제목과 세 단계 조작 안내 카드를 먼저 만드세요. 이 단계는 model 값을 아직 읽지 않으므로 바로 Preview에서 모양을 확인할 수 있습니다.

                @Code(name: "ControlView.swift", file: C02-T04-ControlView-02.swift, previousFile: C02-T03-ControlView-01.swift)
            }

            @Step {
                별자리·점·선 개수, 추적 상태, 상황별 그리기 안내와 보조 속성을 추가하세요.

                @Code(name: "ControlView.swift", file: C02-T04-ControlView-03.swift, previousFile: C02-T04-ControlView-02.swift)
            }

            @Step {
                시작·종료, 그리기 전환과 초기화 버튼을 추가하세요. 공간 전환 메서드는 다음 단계에서 구현하므로 이 스냅샷의 빈 메서드는 임시 자리입니다.

                @Code(name: "ControlView.swift", file: C02-T04-ControlView-04.swift, previousFile: C02-T04-ControlView-03.swift)
            }

            @Step {
                공간 상태에 따라 열기와 닫기를 요청하는 `toggleImmersiveSpace()`를 구현하세요. 사용자 취소와 오류도 공간 상태로 되돌려 버튼이 전환 중에 멈추지 않게 합니다.

                @Code(name: "ControlView.swift", file: C02-T04-ControlView-14.swift, previousFile: C02-T04-ControlView-04.swift) {
                    @Image(source: control-window-simulator.png, alt: "visionOS 26.5 Simulator에서 직접 캡처한 제어창 대기 화면. 조작 안내와 개수가 표시되고 그리기와 초기화 버튼은 비활성화되어 있습니다.")
                }
            }

            @Step {
                **결과 확인**: Simulator에서 세 단계 조작법, 상태 카드, 그리기 상태와 버튼 세 개가 보이면 성공입니다. 몰입형 씬과 손 추적은 Chapter 6에서 연결하므로 지금은 그리기와 초기화 버튼이 비활성화되는 것이 정상입니다.

                오른쪽 코드의 Preview는 실제 Simulator에서 캡처한 대기 화면입니다. 웹에서는 결과 이미지를 비교하고, 자신의 코드를 실행해 보려면 Xcode Canvas의 `#Preview` 또는 Simulator를 사용하세요. 이 캡처는 손 추적 동작을 검증한 화면이 아닙니다.

                @Image(source: control-window-simulator.png, alt: "실제 Simulator의 초기 제어창. 별자리·점·선은 모두 0개이며 그리기 꺼짐 상태입니다.")
            }

            @Step {
                **문제가 생겼다면**: Preview가 모델을 찾지 못하면 `.environment(AppModel())`이 남아 있는지 확인하세요. 시작 버튼은 아직 등록되지 않은 몰입형 씬을 열 수 없으므로 Chapter 6 전에는 외형과 빌드만 확인합니다.
            }
        }
    }
}
