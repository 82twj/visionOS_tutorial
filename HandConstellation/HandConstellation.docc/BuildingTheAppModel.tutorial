@Tutorial(time: 8) {
    @Intro(title: "버튼과 장면이 공유할 상태 만들기") {
        **이번 단계에서 만들 것**: 제어창과 몰입형 공간이 함께 읽고 쓰는 `AppModel`입니다.

        @Image(source: drawing-toggle.png, alt: "그리기 꺼짐과 켜짐 상태를 하나의 앱 모델에서 공유하는 구조")
    }

    @Section(title: "상태의 책임 이해하기") {
        @ContentAndMedia {
            `@Observable`은 값이 바뀌면 그 값을 읽는 SwiftUI 화면을 다시 그립니다. `@MainActor`는 화면 상태 변경을 메인 스레드에 모읍니다.
        }

        @Steps {
            @Step {
                몰입형 공간은 닫힘, 전환 중, 열림을 구분합니다. 전환 중 상태가 시작 버튼의 중복 요청을 막습니다.
            }

            @Step {
                손 추적 상태는 대기, 권한 확인, 추적 중, 미지원, 거부와 오류를 구분합니다. 제어창은 이 값을 사용자 문장으로 바꿉니다.
            }

            @Step {
                `DrawingState`는 켜짐과 꺼짐 두 상태만 가집니다. 제어창 버튼이 `toggleDrawing()`을 호출하고, 몰입형 공간은 같은 값을 관찰합니다.
            }

            @Step {
                점·선·별자리 개수와 기존 점 연결 안내를 공유 상태에 둡니다. 주먹 인식이나 손짓 진행률 상태는 사용하지 않습니다.
            }
        }
    }

    @Section(title: "완성 모델 추가하기") {
        @Steps {
            @Step {
                버튼 기반 그리기 전환, 상황별 안내, 개수와 초기화 신호가 포함된 완성 모델을 추가하세요.

                @Code(name: "AppModel.swift", file: C02-T02-AppModel-12.swift, previousFile: C02-T01-AppModel-00.swift)
            }

            @Step {
                **결과 확인**: `drawingState`의 초기값이 `.disabled`이고 `toggleDrawing()`이 버튼에서 사용할 유일한 사용자 전환 통로인지 확인하세요.
            }

            @Step {
                **문제가 생겼다면**: `@Observable`을 찾지 못하면 첫 줄이 `import Observation`인지 확인하세요.
            }
        }
    }
}
